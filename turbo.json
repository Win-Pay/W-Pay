{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "STELLAR_NETWORK",
    "STELLAR_RPC_URL",
    "STELLAR_HORIZON_URL",
    "SOROBAN_SOURCE_SECRET",
    "API_PORT",
    "API_PUBLIC_URL",
    "WEB_PUBLIC_URL",
    "ADMIN_ADDRESSES",
    "LOG_LEVEL",
    "REDIS_URL",
    "RATE_LIMIT_PER_MINUTE",
    "WEBHOOK_MAX_ATTEMPTS",
    "WEBHOOK_TIMEOUT_MS",
    "WEBHOOK_WORKER",
    "INDEXER_PORT",
    "INDEXER_START_LEDGER",
    "INDEXER_BATCH_SIZE",
    "INDEXER_INTERVAL_MS",
    "NEXT_PUBLIC_API_URL",
    "VITE_API_URL",
    "WPAY_E2E_API_URL",
    "CONTRACT_PAYMENT_ROUTER_ID",
    "CONTRACT_INVOICE_MANAGER_ID",
    "CONTRACT_ESCROW_MANAGER_ID",
    "CONTRACT_REFUND_MANAGER_ID",
    "CONTRACT_SUBSCRIPTION_MANAGER_ID",
    "CONTRACT_SETTLEMENT_MANAGER_ID",
    "CONTRACT_MERCHANT_REGISTRY_ID",
    "CONTRACT_TREASURY_VAULT_ID",
    "CONTRACT_FEE_MANAGER_ID",
    "CONTRACT_CONFIGURATION_MANAGER_ID",
    "CONTRACT_EMERGENCY_PAUSE_ID",
    "CONTRACT_ROLE_MANAGER_ID",
    "CONTRACT_UPGRADE_MANAGER_ID",
    "CONTRACT_PRICE_ORACLE_ID",
    "CONTRACT_GOVERNANCE_ID",
    "CONTRACT_IMPACT_NFT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
