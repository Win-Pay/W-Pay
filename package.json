{
  "name": "wpay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "contracts:build": "bash scripts/build-contracts.sh",
    "contracts:test": "cargo test --manifest-path packages/contracts/Cargo.toml",
    "contracts:fmt": "cargo fmt --manifest-path packages/contracts/Cargo.toml",
    "db:generate": "pnpm --filter @wpay/database generate",
    "db:migrate": "pnpm --filter @wpay/database migrate",
    "db:seed": "pnpm --filter @wpay/database seed",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore-drill": "bash scripts/db-restore-drill.sh",
    "test:browser": "playwright test",
    "measure:testnet": "NODE_PATH=apps/api/node_modules node scripts/measure-testnet-resources.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@prisma/client": "6.19.3",
    "@swc/core": "1.16.22",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.21.5",
    "oxlint": "^0.15.5",
    "prisma": "6.19.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
