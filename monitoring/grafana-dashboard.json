{
  "title": "W-Pay Platform",
  "uid": "wpay-platform",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": [
    "wpay",
    "stellar"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Payment volume (settled)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "wpay_payments_total",
          "legendFormat": "payments"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API availability",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"wpay-api\"}",
          "legendFormat": "api"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Indexer last run (age)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "time() - wpay_indexer_last_run_timestamp_seconds"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Contracts configured",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "wpay_contracts_configured"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Indexer unresolved failures",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "wpay_indexer_unresolved_failures",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    }
  ]
}