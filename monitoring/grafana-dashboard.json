{
  "title": "W-Pay Platform",
  "uid": "wpay-platform",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": [
    "wpay",
    "stellar"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Payment volume (settled)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "wpay_payments_total",
          "legendFormat": "payments"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API availability",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"wpay-api\"}",
          "legendFormat": "api"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Indexer last run (age)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "time() - wpay_indexer_last_run_timestamp_seconds"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Contracts configured",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "wpay_contracts_configured"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Indexer unresolved failures",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "wpay_indexer_unresolved_failures",
          "legendFormat": "failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Settlement eligible payments",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "wpay_settlement_eligible_payments",
          "legendFormat": "eligible"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest pending settlement (age)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "expr": "wpay_settlement_oldest_pending_age_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Settlement reconciliation failures",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "expr": "wpay_settlement_reconciliation_failures{check=\"total\"}",
          "legendFormat": "inconsistencies"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Settlement attempts by failure reason",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "wpay_settlement_retries_total",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Automation batches and execution duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "wpay_settlement_automation_runs_total",
          "legendFormat": "{{outcome}}"
        },
        {
          "expr": "wpay_settlement_execution_duration_seconds{quantile=\"0.95\"}",
          "legendFormat": "p95 duration"
        }
      ]
    }
  ]
}