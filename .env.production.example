# Copy to .env.production (never commit the real file).
# Required by docker-compose.prod.yml.

API_DOMAIN=api.example.com
POSTGRES_USER=wpay
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=wpay
REDIS_PASSWORD=replace-with-a-long-random-password

# 32+ random characters. Rotating it invalidates all access and refresh tokens.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_TTL_DAYS=30

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional: only used to fund/submit server-side Soroban setup transactions.
# Never commit this value. Prefer a dedicated low-balance operational key.
SOROBAN_SOURCE_SECRET=
ADMIN_ADDRESSES=

API_PUBLIC_URL=https://api.example.com
WEB_PUBLIC_URL=https://wpay-web.vercel.app
CORS_ORIGINS=https://wpay-web.vercel.app,https://wpay-merchant.vercel.app,https://wpay-admin.vercel.app

RATE_LIMIT_PER_MINUTE=120
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_WORKER=true
LOG_LEVEL=info
INDEXER_START_LEDGER=5698164
INDEXER_BATCH_SIZE=200
INDEXER_INTERVAL_MS=5000

# Testnet contract IDs recorded in deployments/testnet.json.
