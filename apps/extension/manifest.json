{
  "manifest_version": 3,
  "name": "W-Pay Invoice Helper",
  "version": "0.1.0",
  "description": "Look up W-Pay invoice status from any tab and copy a checkout link.",
  "action": {
    "default_title": "W-Pay",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
