{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "es2022"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["chrome"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.js"]
}
