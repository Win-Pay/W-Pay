# Automatic HTTPS for the public API. Set API_DOMAIN to a DNS name that already
# resolves to this host and Caddy will obtain a Let's Encrypt certificate.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
