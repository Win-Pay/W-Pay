# W-Pay environment template. Copy to .env and fill in real values.
# Never commit .env or any secret. Empty contract ids are intentional until a
# deployment has been verified and recorded in DEPLOYMENTS.md.

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://wpay:wpay_local_only@localhost:5432/wpay?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_TTL_DAYS=30
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated extra browser origins (merchant/admin dashboards).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
LOG_LEVEL=info

# Comma-separated Stellar addresses that are always treated as ADMIN when they
# authenticate with a wallet signature or an API key.
ADMIN_ADDRESSES=

# ---------------------------------------------------------------------------
# Stellar / Soroban
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
# Optional overrides; defaults come from STELLAR_NETWORK.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=
# Secret key for automated operator flows only (refund/settlement execution).
# Leave empty unless a keeper is intentionally configured. Prefer a signer
# service or HSM in production.
SOROBAN_SOURCE_SECRET=

# ---------------------------------------------------------------------------
# Contracts. Deploy, verify and record the id before setting these.
# Empty values make the API return explicit "not configured" errors instead of
# fabricating transactions.
# ---------------------------------------------------------------------------
CONTRACT_PAYMENT_ROUTER_ID=
CONTRACT_INVOICE_MANAGER_ID=
CONTRACT_ESCROW_MANAGER_ID=
CONTRACT_REFUND_MANAGER_ID=
CONTRACT_SUBSCRIPTION_MANAGER_ID=
CONTRACT_SETTLEMENT_MANAGER_ID=
CONTRACT_MERCHANT_REGISTRY_ID=
CONTRACT_TREASURY_VAULT_ID=
CONTRACT_FEE_MANAGER_ID=
CONTRACT_CONFIGURATION_MANAGER_ID=
CONTRACT_EMERGENCY_PAUSE_ID=
CONTRACT_ROLE_MANAGER_ID=
CONTRACT_UPGRADE_MANAGER_ID=
CONTRACT_PRICE_ORACLE_ID=
CONTRACT_GOVERNANCE_ID=
CONTRACT_IMPACT_NFT_ID=

# ---------------------------------------------------------------------------
# Rate limiting and webhooks
# ---------------------------------------------------------------------------
# Set REDIS_URL to share counters across replicas. Unset = in-process counters.
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=5000
# Disable the in-process delivery worker when a separate worker is deployed.
WEBHOOK_WORKER=on

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
INDEXER_PORT=4100
INDEXER_START_LEDGER=1
INDEXER_BATCH_SIZE=100
INDEXER_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# Frontends
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Local Docker Compose only
# ---------------------------------------------------------------------------
POSTGRES_USER=wpay
POSTGRES_PASSWORD=wpay_local_only
POSTGRES_DB=wpay

# ---------------------------------------------------------------------------
# Test-only (optional)
# ---------------------------------------------------------------------------
# Set to a running API to execute the live smoke tests in tests/e2e.
WPAY_E2E_API_URL=
